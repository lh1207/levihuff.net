{
  "name": "levihuff.net",
  "version": "1.0.0",
  "description": "Personal portfolio website of Levi Huff",
  "engines": {
    "node": "^22.15.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "start": "npm run build && run-p dev:11ty dev:css",
    "dev:11ty": "eleventy --serve",
    "dev:css": "tailwindcss -i ./src/_includes/css/tailwind.css -o ./_site/css/styles.css --watch",
    "build": "eleventy && tailwindcss -i ./src/_includes/css/tailwind.css -o ./_site/css/styles.css --minify",
    "watch": "run-p watch:11ty watch:css",
    "watch:11ty": "eleventy --watch",
    "watch:css": "tailwindcss -i ./src/_includes/css/tailwind.css -o ./_site/css/styles.css --watch",
    "audit:ci": "node scripts/audit-dependencies.cjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@11ty/eleventy": "4.0.0-alpha.10"
  },
  "devDependencies": {
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@tailwindcss/cli": "^4.3.3",
    "gray-matter": "npm:@11ty/gray-matter@2.1.0",
    "markdown-it": "^15.0.1",
    "markdown-it-anchor": "^10.0.0",
    "motion": "10.18.0",
    "npm-run-all2": "^9.0.3",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.3",
    "vue": "3.5.43"
  },
  "overrides": {
    "@parcel/watcher": "2.6.0"
  }
}
