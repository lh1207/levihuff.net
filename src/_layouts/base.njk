<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#111317">
  <title>{% if title %}{{ title }} | {% endif %}Levi Huff</title>
  {% if description %}
  <meta name="description" content="{{ description }}">
  {% endif %}
  <meta name="author" content="{{ site.name }}">
  {% if robots %}
  <meta name="robots" content="{{ robots }}">
  {% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {% if isPost %}<meta property="og:type" content="article">
  {% else %}<meta property="og:type" content="website">
  {% endif %}
  <meta property="og:title" content="{% if title %}{{ title }} | {% endif %}Levi Huff">
  {% if description %}
  <meta property="og:description" content="{{ description }}">
  {% endif %}
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="en_US">
  {% if thumbnail %}
  <meta property="og:image" content="{{ site.url }}{{ thumbnail }}">
  {% set thumbDims = thumbnail | imageDimensions %}
  {% if thumbDims %}
  <meta property="og:image:width" content="{{ thumbDims.width }}">
  <meta property="og:image:height" content="{{ thumbDims.height }}">
  {% endif %}
  {% else %}
  <meta property="og:image" content="{{ site.url }}/images/profile.jpg">
  <meta property="og:image:width" content="800">
  <meta property="og:image:height" content="800">
  {% endif %}
  {% if isPost and date %}
  <meta property="article:published_time" content="{{ date | dateIso }}">
  <meta property="article:author" content="{{ site.name }}">
  {% endif %}
  {% if isPost and tags %}
  {% for tag in tags %}{% if tag != "posts" %}
  <meta property="article:tag" content="{{ tag }}">
  {% endif %}{% endfor %}
  {% endif %}
  {% if thumbnail %}
  <meta name="twitter:card" content="summary_large_image">
  {% else %}
  <meta name="twitter:card" content="summary">
  {% endif %}
  <meta name="twitter:title" content="{% if title %}{{ title }} | {% endif %}Levi Huff">
  {% if description %}
  <meta name="twitter:description" content="{{ description }}">
  {% endif %}
  {% if thumbnail %}
  <meta name="twitter:image" content="{{ site.url }}{{ thumbnail }}">
  {% else %}
  <meta name="twitter:image" content="{{ site.url }}/images/profile.jpg">
  {% endif %}
  <link rel="icon" type="image/svg+xml" href="/images/profile.svg">
  <link rel="icon" type="image/jpeg" href="/images/profile.jpg">
  <link rel="apple-touch-icon" href="/images/profile.jpg">
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }}: Blog" href="/feed.xml">
  <link rel="alternate" type="text/plain" title="{{ site.name }}: AI-readable site guide" href="/llms.txt">
  <link rel="author" href="/humans.txt">
  <link rel="me" href="{{ site.social.github }}">
  <link rel="preload" href="/fonts/syne-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/ibm-plex-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="stylesheet" href="/css/styles.css?v={{ gitHash }}">
  <style>[v-cloak]{display:none;}</style>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "{{ site.url }}/#website",
        "name": "{{ site.name }}",
        "url": "{{ site.url }}/",
        "description": {{ site.description | dump | safe }},
        "inLanguage": "en-US",
        "publisher": { "@id": "{{ site.url }}/about/#person" }
      },
      {
        "@type": "Person",
        "@id": "{{ site.url }}/about/#person",
        "name": "{{ site.name }}",
        "url": "{{ site.url }}/about/",
        "image": "{{ site.url }}{{ site.image }}",
        "email": "mailto:{{ site.email }}",
        "jobTitle": {{ site.jobTitle | dump | safe }},
        "description": {{ site.description | dump | safe }},
        "address": {
          "@type": "PostalAddress",
          "addressLocality": {{ site.location.city | dump | safe }},
          "addressRegion": {{ site.location.region | dump | safe }},
          "addressCountry": {{ site.location.country | dump | safe }}
        },
        "hasCredential": [
          {% for credential in site.credentials %}{ "@type": "EducationalOccupationalCredential", "name": {{ credential | dump | safe }} }{% if not loop.last %},
          {% endif %}{% endfor %}
        ],
        "knowsAbout": {{ site.knowsAbout | dump | safe }},
        "alumniOf": {
          "@type": "CollegeOrUniversity",
          "name": "University of Cincinnati"
        },
        "sameAs": [
          "{{ site.social.github }}",
          "{{ site.social.linkedin }}",
          "{{ site.social.handshake }}"
        ]
      }
    ]
  }
  </script>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  {% include "components/nav.njk" %}

  <main id="main-content" tabindex="-1" class="bg-surface-1 text-fg-1">
    {{ content | safe }}
  </main>

  {% include "components/footer.njk" %}

  <button
    class="back-to-top fixed bottom-6 right-6 z-50 w-11 h-11 flex items-center justify-center bg-surface-2 border border-hair-1 hover:border-hair-2 hover:bg-surface-3 text-fg-2 hover:text-fg-1 rounded-d-md shadow-d-md transition-colors duration-[180ms] focus-visible:outline-[3px] focus-visible:outline-amber focus-visible:outline-offset-2"
    aria-label="Back to top"
    hidden>&#8679;</button>

  <script type="module">
    // Motion is a small enhancement for the hero only. All content remains visible
    // if the CDN is unavailable or the visitor prefers reduced motion.
    const hero = document.getElementById('hero');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (hero && !reducedMotion.matches) {
      try {
        const { animate, stagger } = await import('https://cdn.jsdelivr.net/npm/motion@10.18.0/+esm');
        if (!reducedMotion.matches) {
          const items = hero.querySelectorAll('[data-motion="hero-item"]');
          if (items.length) {
            animate(items, { y: [20, 0] }, { delay: stagger(0.12), duration: 0.5, easing: [0.25, 0.1, 0.25, 1] });
          }
        }
      } catch (error) {
        // The static hero is the fallback when the enhancement cannot load.
      }
    }
  </script>

  <script>
    (function () {
      // Hamburger menu
      var navToggle = document.getElementById('nav-toggle');
      var mobileNav = document.getElementById('mobile-nav');
      var iconMenu = document.getElementById('icon-menu');
      var iconClose = document.getElementById('icon-close');
      var mainContent = document.getElementById('main-content');
      var siteFooter = document.getElementById('site-footer');
      var backToTop = document.querySelector('.back-to-top');
      var desktopNav = document.getElementById('nav-menu');
      var desktopBreakpoint = window.matchMedia('(min-width: 801px)');

      function getMobileNavFocusables() {
        var items = [navToggle];
        if (mobileNav) {
          mobileNav.querySelectorAll('a[href], button:not([disabled])').forEach(function (el) {
            items.push(el);
          });
        }
        return items;
      }

      function setMobileNavOpen(isOpen) {
        if (!navToggle || !mobileNav) return;

        navToggle.setAttribute('aria-expanded', String(isOpen));
        mobileNav.classList.toggle('hidden', !isOpen);
        if (iconMenu) iconMenu.classList.toggle('hidden', isOpen);
        if (iconClose) iconClose.classList.toggle('hidden', !isOpen);

        if (mainContent) mainContent.inert = isOpen;
        if (siteFooter) siteFooter.inert = isOpen;
        if (backToTop) backToTop.inert = isOpen;

        if (isOpen) {
          var firstLink = mobileNav.querySelector('a');
          if (firstLink) firstLink.focus();
        }
      }

      if (navToggle && mobileNav) {
        navToggle.hidden = false;
        navToggle.addEventListener('click', function () {
          setMobileNavOpen(navToggle.getAttribute('aria-expanded') !== 'true');
        });

        // Close on Escape
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && navToggle.getAttribute('aria-expanded') === 'true') {
            setMobileNavOpen(false);
            navToggle.focus();
          }

          if (e.key === 'Tab' && navToggle.getAttribute('aria-expanded') === 'true') {
            var focusables = getMobileNavFocusables();
            var first = focusables[0];
            var last = focusables[focusables.length - 1];

            if (e.shiftKey && document.activeElement === first) {
              e.preventDefault();
              last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          }
        });

        // Close when clicking outside
        document.addEventListener('click', function (e) {
          if (
            navToggle.getAttribute('aria-expanded') === 'true' &&
            !mobileNav.contains(e.target) &&
            !navToggle.contains(e.target)
          ) {
            var restoreToggleFocus = mobileNav.contains(document.activeElement);
            setMobileNavOpen(false);
            if (restoreToggleFocus) navToggle.focus();
          }
        });

        // This also covers browsers that do not yet support inert. If focus moves
        // away from the disclosure, close it instead of leaving an open drawer.
        document.addEventListener('focusin', function (e) {
          if (
            navToggle.getAttribute('aria-expanded') === 'true' &&
            !mobileNav.contains(e.target) &&
            !navToggle.contains(e.target)
          ) {
            setMobileNavOpen(false);
          }
        });

        // Close when a nav link is clicked
        mobileNav.querySelectorAll('a').forEach(function (link) {
          link.addEventListener('click', function () {
            setMobileNavOpen(false);
          });
        });

        // CSS hides the mobile controls at this breakpoint. Close the drawer and
        // return focus to the matching desktop link before its mobile target hides.
        desktopBreakpoint.addEventListener('change', function (e) {
          if (!e.matches || navToggle.getAttribute('aria-expanded') !== 'true') return;

          var activeElement = document.activeElement;
          var shouldMoveFocus = activeElement === navToggle || mobileNav.contains(activeElement);
          setMobileNavOpen(false);

          if (shouldMoveFocus && desktopNav) {
            var currentLink = desktopNav.querySelector('a[aria-current]') || desktopNav.querySelector('a');
            if (currentLink) currentLink.focus();
          }
        });
      }

      var btn = document.querySelector('.back-to-top');
      if (btn) {
        window.addEventListener('scroll', function () {
          if (window.scrollY > 400) {
            btn.removeAttribute('hidden');
          } else {
            if (document.activeElement === btn && mainContent) {
              mainContent.focus({ preventScroll: true });
            }
            btn.setAttribute('hidden', '');
          }
        }, { passive: true });
        btn.addEventListener('click', function () {
          var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (mainContent) mainContent.focus({ preventScroll: true });
          window.scrollTo({ top: 0, behavior: prefersReducedMotion ? 'auto' : 'smooth' });
        });
      }
    })();
  </script>
</body>
</html>
