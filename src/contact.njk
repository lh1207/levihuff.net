<div class="bg-surface-1 text-fg-1">
  <section class="py-16 md:py-20">
    <div class="max-w-site mx-auto px-4 md:px-6">
      <p class="font-jb text-mono-xs uppercase text-amber" aria-hidden="true">&#9658; CONTACT</p>
      <h1 class="font-syne text-4xl font-bold text-fg-1 mt-3">Let’s talk support work.</h1>
      <p class="font-plex text-lg text-fg-2 leading-relaxed mt-4 max-w-prose">{{ career.seeking }}</p>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <div class="bg-surface-2 border border-hair-1 rounded-d-lg p-6">
          <p class="font-jb text-mono-xs uppercase text-amber">EMAIL</p>
          <a href="mailto:{{ site.email }}" class="font-plex text-lg text-amber mt-3 block focus-visible:outline-[3px] focus-visible:outline-amber focus-visible:outline-offset-2">{{ site.email }}</a>
          <div class="mt-6 flex flex-col gap-3">
            <a href="{{ site.social.github }}" class="font-jb text-sm text-fg-2 focus-visible:outline-[3px] focus-visible:outline-amber focus-visible:outline-offset-2">GitHub &rarr;</a>
            <a href="{{ site.social.linkedin }}" class="font-jb text-sm text-fg-2 focus-visible:outline-[3px] focus-visible:outline-amber focus-visible:outline-offset-2">LinkedIn &rarr;</a>
          </div>
        </div>
        <div class="bg-surface-2 border border-hair-1 rounded-d-lg p-6">
          <p class="font-jb text-mono-xs uppercase text-amber">PREFERENCES</p>
          <p class="font-plex text-base text-fg-2 leading-relaxed mt-3">Based in {{ career.location.base }}. {{ career.location.preference }}</p>
        </div>
      </div>
    </div>
  </section>
</div>
