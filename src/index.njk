---
layout: base.njk
title: IT support and help desk
description: Levi Huff, Information Technology graduate in Washington Court House, Ohio. Prior IT support and recent Kroger customer service. Seeking help desk and desktop support roles.
---

<div class="bg-surface-1 text-fg-1">
  <section class="py-16 md:py-20">
    <div class="max-w-site mx-auto px-4 md:px-6">
      <div class="flex flex-col md:flex-row md:items-center md:gap-12 lg:gap-16">
        <div class="flex-1 min-w-0 max-w-prose">
          <p class="font-jb text-mono-xs tracking-[0.04em] uppercase text-amber" aria-hidden="true">&#9658; IT SUPPORT</p>
          <h1 class="font-syne text-4xl md:text-5xl font-bold leading-[1.1] text-fg-1 mt-3">Levi Huff</h1>
          <h2 class="font-syne text-2xl md:text-3xl font-semibold text-fg-1 mt-4">{{ career.headline }}</h2>
          <p class="font-plex text-lg text-fg-2 leading-relaxed mt-4">{{ career.summary }}</p>
          <p class="font-plex text-base text-fg-3 leading-relaxed mt-4">{{ career.background }}</p>
          <p class="font-plex text-base text-fg-2 mt-3">{{ career.seeking }}</p>
          <p class="font-plex text-base text-fg-2 leading-relaxed mt-4"><strong>{{ career.degree }}</strong>, {{ career.institution }}. {{ career.study }}</p>
          <p class="font-jb text-mono-sm text-fg-3 mt-4">Based in {{ career.location.base }}. {{ career.location.preference }}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/files/Levi_Huff_Resume.pdf" download="Levi_Huff_Resume.pdf" class="inline-flex items-center bg-amber text-surface-0 font-plex font-semibold px-6 py-3 rounded-md focus-visible:outline-[3px] focus-visible:outline-amber focus-visible:outline-offset-2">Download resume</a>
            <a href="/about/#experience" class="inline-flex items-center bg-surface-2 border border-hair-1 text-fg-1 font-plex font-medium px-6 py-3 rounded-md focus-visible:outline-[3px] focus-visible:outline-amber focus-visible:outline-offset-2">See experience</a>
            <a href="mailto:{{ site.email }}" class="inline-flex items-center bg-surface-2 border border-hair-1 text-fg-1 font-plex font-medium px-6 py-3 rounded-md focus-visible:outline-[3px] focus-visible:outline-amber focus-visible:outline-offset-2">Email me</a>
          </div>
        </div>
        <div class="mt-10 md:mt-0 flex-shrink-0">
          <img src="/images/profile.jpg" alt="Levi Huff" width="800" height="800" loading="eager" class="w-40 h-40 md:w-52 md:h-52 rounded-full object-cover border-2 border-hair-1">
        </div>
      </div>
    </div>
  </section>

  <section id="experience" class="py-12 md:py-16">
    <div class="max-w-site mx-auto px-4 md:px-6">
      <p class="font-jb text-mono-xs uppercase text-amber" aria-hidden="true">&#9658; EXPERIENCE</p>
      <h2 class="font-syne text-3xl font-semibold text-fg-1 mt-2">Support experience.</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {% for entry in experience %}
          {% if loop.index <= 3 %}
          <div class="bg-surface-2 border border-hair-1 rounded-d-lg p-6">
            <h3 class="font-syne text-xl font-semibold text-fg-1">{{ entry.company }}</h3>
            <p class="font-jb text-mono-sm text-fg-3 mt-2">{{ entry.focusAreas }}</p>
            <p class="font-plex text-base text-fg-2 leading-relaxed mt-4">{{ entry.description }}</p>
          </div>
          {% endif %}
        {% endfor %}
      </div>
      <a href="/about/#experience" class="inline-flex mt-6 font-jb text-sm text-amber focus-visible:outline-[3px] focus-visible:outline-amber focus-visible:outline-offset-2">Full experience &rarr;</a>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="max-w-site mx-auto px-4 md:px-6">
      <p class="font-jb text-mono-xs uppercase text-amber" aria-hidden="true">&#9658; SUPPORT AREAS</p>
      <h2 class="font-syne text-3xl font-semibold text-fg-1 mt-2">What I can support.</h2>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {% for area in career.supportAreas %}
        <article class="bg-surface-2 border border-hair-1 rounded-d-lg p-6">
          <h3 class="font-syne text-xl font-semibold text-fg-1">{{ area.heading }}</h3>
          <p class="font-plex text-base text-fg-2 leading-relaxed mt-3">{{ area.text }}</p>
        </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="max-w-site mx-auto px-4 md:px-6">
      <p class="font-jb text-mono-xs uppercase text-amber" aria-hidden="true">&#9658; LAB NOTES</p>
      <h2 class="font-syne text-3xl font-semibold text-fg-1 mt-2">Personal infrastructure work.</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {% for entry in infra %}
          {% if entry.featured %}
            {% include "components/infra-card.njk" %}
          {% endif %}
        {% endfor %}
      </div>
      <a href="/infrastructure/" class="inline-flex mt-6 font-jb text-sm text-amber focus-visible:outline-[3px] focus-visible:outline-amber focus-visible:outline-offset-2">View lab notes &rarr;</a>
    </div>
  </section>
</div>


<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "{{ site.url }}/#webpage",
  "url": "{{ site.url }}/",
  "name": "Levi Huff | IT support",
  "description": {{ description | dump | safe }},
  "isPartOf": { "@id": "{{ site.url }}/#website" },
  "about": { "@id": "{{ site.url }}/about/#person" },
  "mainEntity": { "@id": "{{ site.url }}/about/#person" },
  "inLanguage": "en-US"
}
</script>
